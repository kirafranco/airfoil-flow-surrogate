# airfoil-flow-surrogate — service configuration template.
#
# Copy to .env next to this file and replace every CHANGE_ME:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file is versioned and
# changes in the same commit as .env whenever a key is added or removed.
# Generate secrets, do not invent them, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# Prefixes every container, image and network of this project.
COMPOSE_PROJECT_NAME=airfoil-surrogate

# --- Jupyter (dev profile) ----------------------------------------------------
# Token for the browser session.
JUPYTER_TOKEN=CHANGE_ME
# Host port. 8889 rather than 8888, so it can run beside another JupyterLab.
JUPYTER_PORT=8889
# 127.0.0.1 is localhost: JupyterLab opens at http://localhost:8889 on this
# machine and answers nothing else. A notebook server executes arbitrary code,
# so do not expose it to a network.
JUPYTER_BIND_ADDRESS=127.0.0.1
