# Files read inside Linux containers keep LF endings on a Windows checkout: a
# CRLF in a shell script breaks bash in the container, which reports the stray
# carriage return as a command it cannot find.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
